# PostgreSQL (must match docker-compose.yml)
# Note: host port 5433 (5432 was already taken by a native PostgreSQL on this machine)
POSTGRES_USER=rita
POSTGRES_PASSWORD=rita
POSTGRES_DB=automatizacionrita
DATABASE_URL=postgresql://rita:rita@localhost:5433/automatizacionrita

# API
PORT=3000

# Integration tests (optional; when unset, tests derive <database>_test from DATABASE_URL)
# TEST_DATABASE_URL=postgresql://rita:rita@localhost:5432/automatizacionrita_test

# WhatsApp Cloud API webhook (apps/api/src/features/webhook)
# Defaults match the zod schema in apps/api/src/config/env.ts for local dev.
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_APP_SECRET=test-app-secret
WHATSAPP_OWNER_PHONE=+5491100000000
OWNER_ID=default

# Dashboard (apps/dashboard)
VITE_OWNER_ID=default
