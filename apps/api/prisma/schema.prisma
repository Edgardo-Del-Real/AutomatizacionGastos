generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (Supabase pooler on 6543 in production).
  url       = env("DATABASE_URL")
  // Direct connection for the CLI: migrations must not run through the pooler.
  directUrl = env("DIRECT_URL")
}

enum MovementType {
  EXPENSE
  INCOME
  SAVINGS
}

enum MovementVisibility {
  INDIVIDUAL
  SHARED
}

enum MovementStatus {
  PENDING
  PAID
}

enum MovementSavingsOrigin {
  AUTO_SPLIT
  MANUAL
}

enum CategoryType {
  NORMAL
  MIXED
  EXPENSE
  INCOME
  SAVINGS
}

model Expense {
  id          String            @id @default(cuid())
  ownerId     String
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("ARS")
  category    String?
  note        String?
  occurredAt  DateTime
  createdAt   DateTime          @default(now())
  type        MovementType      @default(EXPENSE)
  visibility  MovementVisibility @default(INDIVIDUAL)
  status      MovementStatus    @default(PAID)
  // shared-expense-split: full gross the sender split from; set only on a
  // shared-split row, null (inert) for every legacy movement.
  sharedTotal Decimal?          @db.Decimal(12, 2)
  // manual-savings: origin of a SAVINGS row; null (inert) on every legacy row
  // and on the net INCOME of a split — only MANUAL rows are ever deducted.
  savingsOrigin MovementSavingsOrigin?

  @@index([ownerId, occurredAt])
  @@index([ownerId])
}

model ProcessedMessage {
  id          String   @id @default(cuid())
  chatId      String
  messageId   String
  ownerId     String
  processedAt DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([ownerId])
}

model Category {
  id        String             @id @default(cuid())
  ownerId   String
  name      String
  type      CategoryType       @default(MIXED)
  createdAt DateTime           @default(now())
  keywords  CategoryKeyword[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model SavingsRule {
  id        String   @id @default(cuid())
  ownerId   String
  keyword   String
  percent   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([ownerId, keyword])
  @@index([ownerId])
}

model CategoryKeyword {
  id         String   @id @default(cuid())
  categoryId String
  keyword    String
  ownerId    String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([ownerId, keyword])
  @@index([ownerId])
}

model BotState {
  ownerId           String   @id
  state             String
  pendingMovementId String?
  pendingNote       String?
  updatedAt         DateTime @updatedAt
}

// household-isolation: users live in the database, not in the deploy env.
// AUTH_USERS/HOUSEHOLD_MEMBERS are only a bootstrap seed (insert-if-missing).
model User {
  ownerId   String   @id
  name      String
  chatId    String   @unique
  salt      String
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

// A pending "may I see your dashboard?" ask. It expires on its own so a
// forgotten request can never be accepted days later.
model AccessRequest {
  id                String              @id @default(cuid())
  requesterId       String
  targetOwnerId     String
  status            AccessRequestStatus @default(PENDING)
  telegramMessageId Int?
  createdAt         DateTime            @default(now())
  decidedAt         DateTime?
  expiresAt         DateTime

  @@index([requesterId, status])
  @@index([targetOwnerId, status])
}

// The granted permission: read-only, 30 minutes, revocable before it expires.
model AccessGrant {
  id            String    @id @default(cuid())
  requesterId   String
  targetOwnerId String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([requesterId, expiresAt])
}
