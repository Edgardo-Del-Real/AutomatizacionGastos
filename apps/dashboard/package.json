{
  "name": "@rita/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite + React 19 read-only dashboard: expense metrics and list.",
  "scripts": {
    "dev": "pnpm --filter @rita/contracts build && vite",
    "build": "pnpm --filter @rita/contracts build && tsc -p tsconfig.json && vite build",
    "test": "pnpm --filter @rita/contracts build && vitest run",
    "test:watch": "pnpm --filter @rita/contracts build && vitest",
    "typecheck": "pnpm --filter @rita/contracts build && tsc -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rita/contracts": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}