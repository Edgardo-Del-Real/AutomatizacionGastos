{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @rita/contracts build && pnpm --filter @rita/dashboard build",
  "outputDirectory": "apps/dashboard/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rita-api.onrender.com/:path*"
    }
  ]
}
